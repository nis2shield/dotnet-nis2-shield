{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Nis2Shield": "Debug"
        }
    },
    "AllowedHosts": "*",
    "Nis2": {
        "Enabled": true,
        "IntegrityKey": "demo-hmac-secret-key-change-in-production",
        "EncryptionKey": "",
        "Logging": {
            "Enabled": true,
            "AnonymizeIp": true,
            "EncryptPii": false
        },
        "ActiveDefense": {
            "RateLimitEnabled": true,
            "RateLimitThreshold": 10,
            "RateLimitWindowSeconds": 60,
            "BlockTorExitNodes": false
        },
        "SessionGuard": {
            "Enabled": true,
            "SubnetTolerance": 24,
            "AllowUserAgentChange": true
        },
        "Siem": {
            "Enabled": false,
            "Provider": "None"
        },
        "Webhooks": {
            "Enabled": false,
            "Targets": []
        }
    }
}